{
    "name": "asmit/filament-upload",
    "description": "Filament PDF file upload and preview.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Asmit\\FilamentUpload\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asmit\\FilamentUpload\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "AsmitNepali",
            "email": "mail2asmitnepali@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "filament/support": "^3.0|^4.0|^5.0"
    },
    "extra": {
        "laravel": {
            "providers": [
              "Asmit\\FilamentUpload\\FilamentUploadServiceProvider"
            ]
        }
    },
    "prefer-stable": true,
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "filament/filament": "^4.0|^5.0"
    }
}
